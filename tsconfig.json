{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@lib/shared/src/*": [
        "./shared/src/*"
      ]
    }
  },
  "include": [
    "be/apps",
    "fe/src",
    "shared/src",
    "shared/index.ts"
  ],
  "exclude": [
    "fe/node_modules",
    "fe/.next",
    "be/node_modules",
    "be/dist"
  ]
}